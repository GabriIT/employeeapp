http {
    include mime.types;
    default_type  application/octet-stream;

    upstream client {
        server client-promptq:3000;
    }

    upstream server {
        server server-promptq:8080;
    }

    server {
        listen 80;
        listen [::]:80;

        # Client (Next.js app) setup
        location / {
            proxy_set_header Host $host;
            proxy_pass http://client;
        }

        # Server (Gin app) setup
        location /api/ {
            proxy_set_header Host $host;
            proxy_pass http://server;
        }
    }
}

events {}
